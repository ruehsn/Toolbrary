<% loan = tool.borrow_requests.find(&:approved?) %>
<% if loan.nil? %>
  <span class="badge available">Available</span>
<% elsif loan.overdue? %>
  <span class="badge overdue">Overdue</span>
<% else %>
  <span class="badge lent">Lent out until <%= l loan.due_date, format: :short %></span>
<% end %>
