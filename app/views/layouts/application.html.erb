<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Tool Share" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="application-name" content="Tool Share">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="topbar">
      <div class="wrap topbar-inner">
        <%= link_to "🔧 Tool Share", root_path, class: "brand" %>
        <nav>
          <%= link_to "Browse tools", root_path %>
          <%= link_to "Categories", categories_path %>
          <% if authenticated? %>
            <%= link_to "My dashboard", dashboard_path %>
            <%= link_to "Account", account_path %>
            <%= link_to "+ Add tool", new_tool_path, class: "btn btn-small" %>
            <%= button_to "Sign out", session_path, method: :delete, class: "linklike" %>
          <% else %>
            <%= link_to "Sign in", new_session_path %>
            <%= link_to "Sign up", new_registration_path, class: "btn btn-small" %>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <% if notice.present? %><p class="flash notice"><%= notice %></p><% end %>
      <% if alert.present? %><p class="flash alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
