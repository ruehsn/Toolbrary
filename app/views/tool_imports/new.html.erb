<% content_for :title, "Add tools from photos · Tool Share" %>
<h1>📷 Add tools from photos</h1>
<%= form_with model: @tool_import, class: "card narrow" do |f| %>
  <p style="margin-top:0">Snap your bench, pegboard or shed shelves. AI finds each tool, crops a photo of it and drafts the listing. You review everything before it's added.</p>
  <%= render "shared/errors", record: @tool_import %>
  <div class="field">
    <%= f.label :photos, "Photos (up to #{ToolImport::MAX_PHOTOS})" %>
    <%= f.file_field :photos, multiple: true, accept: Tool::PHOTO_TYPES.join(","), required: true, name: "tool_import[photos][]" %>
  </div>
  <fieldset class="field choice">
    <legend>Which AI should look at them?</legend>
    <label>
      <%= f.radio_button :analysis, "assistant", checked: !ToolPhotoAnalyzer.configured? %>
      <span><strong>My own AI assistant</strong><br><span class="small muted">Any MCP-capable assistant (Claude, Cursor, a local model…) connected under
      <%= link_to "Account → AI assistants", account_path(anchor: "ai-assistants") %>. Photos stay here until your assistant fetches them.</span></span>
    </label>
    <label class="<%= "disabled" unless ToolPhotoAnalyzer.configured? %>">
      <%= f.radio_button :analysis, "builtin", checked: ToolPhotoAnalyzer.configured?, disabled: !ToolPhotoAnalyzer.configured? %>
      <span><strong>Built-in AI</strong><br><span class="small muted"><%= ToolPhotoAnalyzer.configured? ? "Analysed right away on this server, using Anthropic's Claude." : "Not set up on this server." %></span></span>
    </label>
  </fieldset>
  <ul class="small muted">
    <li>Lay tools out with a little space between them, in good light.</li>
    <li>About 3–12 tools per photo works best.</li>
    <li>Photos are only shared with the AI you choose.</li>
  </ul>
  <%= f.submit "Find my tools", class: "btn btn-block", data: { turbo_submits_with: "Uploading…" } %>
<% end %>
